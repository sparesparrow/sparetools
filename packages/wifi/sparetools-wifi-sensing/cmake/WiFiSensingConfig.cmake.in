@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find dependencies
find_dependency(Eigen3)
find_dependency(Boost)
find_dependency(FFTW3)
find_dependency(OpenCV)
find_dependency(HDF5)
find_dependency(yaml-cpp)

# Optional Qt dependency
if(@QT_AVAILABLE@)
    find_dependency(Qt6 COMPONENTS Widgets Charts DataVisualization)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/WiFiSensingTargets.cmake")

check_required_components(WiFiSensing)