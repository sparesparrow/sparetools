[layouts]
  [[cursor_agent_multi]]
    [[[child0]]]
      type = Window
      parent = ""
      order = 0
      position = 0:0
      size = 1920:1080
    [[[child1]]]
      type = VPaned
      parent = child0
      order = 0
      position = 0
      ratio = 0.4
    [[[child2]]]
      type = HPaned
      parent = child1
      order = 0
      position = 0
      ratio = 0.5
    [[[child3]]]
      type = Terminal
      parent = child2
      order = 0
      profile = agent_primary
      command = ""
    [[[child4]]]
      type = Terminal
      parent = child2
      order = 1
      profile = agent_secondary
      command = ""
    [[[child5]]]
      type = HPaned
      parent = child1
      order = 1
      position = 0
      ratio = 0.5
    [[[child6]]]
      type = Terminal
      parent = child5
      order = 0
      profile = agent_research
      command = ""
    [[[child7]]]
      type = Terminal
      parent = child5
      order = 1
      profile = agent_execution
