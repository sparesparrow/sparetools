{
  "profile_name": "Accessibility Multi-Controller Setup",
  "description": "Accessibility-focused mapping with voice control, large button support, and assistive features",
  "version": "2.0",
  "controllers": {
    "primary_accessibility_controller": {
      "device_id": "auto_detect",
      "name": "Primary Accessibility Controller",
      "connection_type": "USB",
      "mappings": {
        "buttons": {
          "A": "KEY_ENTER",
          "B": "KEY_ESC",
          "X": "KEY_SPACE",
          "Y": "KEY_TAB",
          "LB": "KEY_LEFTSHIFT",
          "RB": "KEY_RIGHTCTRL",
          "LT": "KEY_LEFTCTRL",
          "RT": "KEY_LEFTALT",
          "SELECT": "KEY_F1",
          "START": "KEY_F2",
          "LS": "KEY_F3",
          "RS": "KEY_F4",
          "DPAD_UP": "KEY_UP",
          "DPAD_DOWN": "KEY_DOWN",
          "DPAD_LEFT": "KEY_LEFT",
          "DPAD_RIGHT": "KEY_RIGHT"
        },
        "axes": {
          "LEFT_X": "MOUSE_X",
          "LEFT_Y": "MOUSE_Y",
          "RIGHT_X": "MOUSE_WHEEL_H",
          "RIGHT_Y": "MOUSE_WHEEL_V",
          "LEFT_TRIGGER": "MOUSE_LEFT_BUTTON",
          "RIGHT_TRIGGER": "MOUSE_RIGHT_BUTTON"
        },
        "accessibility_combinations": {
          "LB+A": "KEY_LEFTSHIFT+KEY_ENTER",
          "RB+B": "KEY_RIGHTCTRL+KEY_ESC",
          "LT+X": "KEY_LEFTCTRL+KEY_SPACE",
          "RT+Y": "KEY_LEFTALT+KEY_TAB",
          "SELECT+START": "KEY_F1+KEY_F2"
        }
      },
      "accessibility_features": {
        "large_button_mode": true,
        "sticky_keys": true,
        "slow_keys": true,
        "bounce_keys": true,
        "mouse_keys": true,
        "high_contrast": true,
        "voice_feedback": true
      }
    },
    "secondary_accessibility_controller": {
      "device_id": "auto_detect",
      "name": "Secondary Accessibility Controller",
      "connection_type": "BLUETOOTH",
      "mappings": {
        "buttons": {
          "A": "KEY_F5",
          "B": "KEY_F6",
          "X": "KEY_F7",
          "Y": "KEY_F8",
          "LB": "KEY_F9",
          "RB": "KEY_F10",
          "LT": "KEY_F11",
          "RT": "KEY_F12",
          "SELECT": "KEY_PRINT",
          "START": "KEY_SCROLLLOCK",
          "LS": "KEY_PAUSE",
          "RS": "KEY_INSERT",
          "DPAD_UP": "KEY_PAGEUP",
          "DPAD_DOWN": "KEY_PAGEDOWN",
          "DPAD_LEFT": "KEY_HOME",
          "DPAD_RIGHT": "KEY_END"
        },
        "axes": {
          "LEFT_X": "MOUSE_X",
          "LEFT_Y": "MOUSE_Y",
          "RIGHT_X": "MOUSE_WHEEL_H",
          "RIGHT_Y": "MOUSE_WHEEL_V",
          "LEFT_TRIGGER": "MOUSE_LEFT_BUTTON",
          "RIGHT_TRIGGER": "MOUSE_RIGHT_BUTTON"
        }
      },
      "accessibility_features": {
        "large_button_mode": true,
        "sticky_keys": true,
        "slow_keys": true,
        "bounce_keys": true,
        "mouse_keys": true,
        "high_contrast": true,
        "voice_feedback": true
      }
    }
  },
  "voice_alerts": {
    "enabled": true,
    "voice": "default",
    "speed": 0.8,
    "volume": 1.0,
    "alerts": {
      "controller_connected": "Accessibility controller {name} connected successfully!",
      "controller_disconnected": "Accessibility controller {name} disconnected!",
      "mapping_loaded": "Accessibility mapping {name} loaded successfully!",
      "assistive_mode_enabled": "Assistive mode enabled!",
      "error": "Accessibility error: {error}"
    }
  },
  "accessibility_features": {
    "voice_control": true,
    "gesture_recognition": true,
    "eye_tracking_support": true,
    "switch_control": true,
    "voice_over": true,
    "screen_reader": true,
    "magnification": true,
    "high_contrast": true,
    "large_text": true,
    "color_inversion": true
  },
  "assistive_technologies": {
    "screen_reader": {
      "enabled": true,
      "voice": "default",
      "speed": 0.8
    },
    "voice_control": {
      "enabled": true,
      "commands": {
        "click": "Click at current position",
        "double_click": "Double click at current position",
        "right_click": "Right click at current position",
        "scroll_up": "Scroll up",
        "scroll_down": "Scroll down",
        "zoom_in": "Zoom in",
        "zoom_out": "Zoom out"
      }
    },
    "switch_control": {
      "enabled": true,
      "scanning_speed": 1.0,
      "auto_scan": true
    }
  }
}