  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">#centralwidget, #scrollAreaWidgetContents_2
{
	background-color: #dddddd;
}

QLineEdit,QTreeWidget, QPlainTextEdit
{
	background: white;
	border: 1px solid #e3e3e3;
	color: #303030;
	padding: 4px;
}
QLineEdit
{
	color: #b7b7b7;
}

QLineEdit:enabled
{
	color: #000000;
}



QPushButton{
	font-weight: bold;
	font-size: 11px;
	padding: 4px 7px;
	text-transform: uppercase;
      min-width: 6em;
	border-radius: 0;
	border: 0;
      
}

QPushButton:disabled
{
	background: #ffffff;
	border: 1px solid #e3e3e3;
	color: #b7b7b7;
}

QPushButton:enabled
{
	background: #1792e5;
	border: 1px solid #1792e5;
	color: #ffffff;
}
QPushButton:hover
{
	background: #1272b2;
	border: 1px solid #1272b2;
	color: #ffffff;
}
QPushButton:pressed
{
	background: #23608c;
	border: 1px solid #23608c;
	color: #ffffff;
}
QGroupBox#mmGroupBox::title
{
	padding: 0;
}
QGroupBox#mmGroupBox
{
	background: #fff;
	border: 0px;
	text-transform: uppercase;
	font-weight: bold;
	text-align: left;
}
QGroupBox#fdeGroupBox, QGroupBox#cmdGroupBox, QGroupBox#msGroupBox, QGroupBox#runScriptGroupBox, QGroupBox#msStatusGroupBox
{
	background: #fff;
	border: 0px;
	text-transform: uppercase;
	font-weight: bold;
	text-align: left;
}
QGroupBox#fdeGroupBox::title, QGroupBox#cmdGroupBox::title, QGroupBox#msGroupBox::title, QGroupBox#runScriptGroupBox::title, QGroupBox#msStatusGroupBox::title
{
	background: #303030;
	font-size: 12pt;
	color: #ffffff;
	padding: 4px 16000px 4px 7px;
	text-align: left;
	subcontrol-position: top left;
	subcontrol-origin: margin;
}
QLabel#configurationLabel
{
	background: #ffffff;
	border: 1px solid #ccc;
	color: #b7b7b7;
	padding: 0 5px;
}
QGroupBox#progConfDbGrpBox, QGroupBox#progConfGrpBox
{
	text-transform: uppercase;
	font-weight: bold;
	text-align: left;
	border: 0;
}
QGroupBox#progConfDbGrpBox::title, QGroupBox#progConfGrpBox::title
{
padding: 0;
}
#horizontalLayout_5
{
	background: #ffffff;
}
QFrame#progConfBg
{
background: #ffffff;
	border: 1px solid #ccc;
}</string>
