{
  "flowchart_examples": {
    "simple_process": {
      "template_name": "flowchart-template",
      "variables": {
        "title": "Simple Process Flow",
        "steps": ["Start", "Input Data", "Process", "Validate", "End"],
        "connections": [
          {"from": "Start", "to": "Input Data", "label": ""},
          {"from": "Input Data", "to": "Process", "label": ""},
          {"from": "Process", "to": "Validate", "label": ""},
          {"from": "Validate", "to": "End", "label": "Valid"},
          {"from": "Validate", "to": "Process", "label": "Invalid"}
        ]
      }
    },
    "complex_workflow": {
      "template_name": "flowchart-template",
      "variables": {
        "title": "Complex Workflow",
        "steps": ["Start", "Initialize", "Load Data", "Process", "Decision", "Save", "Cleanup", "End"],
        "connections": [
          {"from": "Start", "to": "Initialize", "label": ""},
          {"from": "Initialize", "to": "Load Data", "label": ""},
          {"from": "Load Data", "to": "Process", "label": ""},
          {"from": "Process", "to": "Decision", "label": ""},
          {"from": "Decision", "to": "Save", "label": "Success"},
          {"from": "Decision", "to": "Cleanup", "label": "Error"},
          {"from": "Save", "to": "Cleanup", "label": ""},
          {"from": "Cleanup", "to": "End", "label": ""}
        ]
      }
    }
  },
  "sequence_examples": {
    "api_interaction": {
      "template_name": "sequence-template",
      "variables": {
        "title": "API Interaction Flow",
        "actors": ["Client", "API Gateway", "Auth Service", "Database", "Cache"],
        "interactions": [
          {"from": "Client", "to": "API Gateway", "message": "Request", "type": "solid"},
          {"from": "API Gateway", "to": "Auth Service", "message": "Validate Token", "type": "solid"},
          {"from": "Auth Service", "to": "API Gateway", "message": "Token Valid", "type": "dashed"},
          {"from": "API Gateway", "to": "Cache", "message": "Check Cache", "type": "solid"},
          {"from": "Cache", "to": "API Gateway", "message": "Cache Miss", "type": "dashed"},
          {"from": "API Gateway", "to": "Database", "message": "Query Data", "type": "solid"},
          {"from": "Database", "to": "API Gateway", "message": "Data", "type": "dashed"},
          {"from": "API Gateway", "to": "Client", "message": "Response", "type": "solid"}
        ]
      }
    }
  },
  "class_examples": {
    "user_management": {
      "template_name": "class-template",
      "variables": {
        "title": "User Management System",
        "classes": [
          {
            "name": "User",
            "methods": ["+login()", "+logout()", "+getProfile()", "+updateProfile()"],
            "attributes": ["-username: String", "-email: String", "-password: String", "-lastLogin: Date"]
          },
          {
            "name": "UserService",
            "methods": ["+authenticate()", "+createUser()", "+deleteUser()", "+updateUser()"],
            "attributes": ["-userRepository: UserRepository", "-authService: AuthService"]
          },
          {
            "name": "UserRepository",
            "methods": ["+findById()", "+save()", "+delete()", "+findByEmail()"],
            "attributes": ["-database: Database", "-cache: Cache"]
          },
          {
            "name": "AuthService",
            "methods": ["+hashPassword()", "+verifyPassword()", "+generateToken()"],
            "attributes": ["-secretKey: String", "-tokenExpiry: int"]
          }
        ],
        "relationships": [
          {"from": "UserService", "to": "User", "type": "uses", "label": "manages"},
          {"from": "UserService", "to": "UserRepository", "type": "uses", "label": "1..1"},
          {"from": "UserService", "to": "AuthService", "type": "uses", "label": "1..1"},
          {"from": "UserRepository", "to": "User", "type": "uses", "label": "persists"}
        ]
      }
    }
  },
  "state_examples": {
    "order_processing": {
      "template_name": "state-template",
      "variables": {
        "title": "Order Processing States",
        "states": ["Pending", "Confirmed", "Processing", "Shipped", "Delivered", "Cancelled"],
        "transitions": [
          {"from": "Pending", "to": "Confirmed", "trigger": "payment_received", "condition": "valid_payment"},
          {"from": "Confirmed", "to": "Processing", "trigger": "start_processing", "condition": "inventory_available"},
          {"from": "Processing", "to": "Shipped", "trigger": "ship_order", "condition": "order_ready"},
          {"from": "Shipped", "to": "Delivered", "trigger": "delivery_confirmed", "condition": "delivery_successful"},
          {"from": "Pending", "to": "Cancelled", "trigger": "cancel_order", "condition": "cancellation_requested"},
          {"from": "Confirmed", "to": "Cancelled", "trigger": "cancel_order", "condition": "before_processing"},
          {"from": "Processing", "to": "Cancelled", "trigger": "cancel_order", "condition": "before_shipping"}
        ]
      }
    }
  },
