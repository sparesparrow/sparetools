[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=11
compiler.libcxx=libstdc++11
build_type=Debug

[options]
*:shared=True
boost:without_python=False
qt:with_widgets=True
opencv:with_cuda=False

[build_requires]
cmake/3.25.0
ninja/1.11.1

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:verbosity=verbose