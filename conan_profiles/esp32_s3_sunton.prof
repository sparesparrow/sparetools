[include]
../conan_profiles/esp32_base.prof

[settings]
arch=xtensa
compiler=gcc
compiler.version=12
compiler.libcxx=libstdc++11
build_type=Release

[options]
# Sunton display specific options
lvgl:shared=False
lvgl:tft_espi=True
lvgl:xpt2046=True
*:shared=False
*:fPIC=True

# ESP32-S3 specific optimizations
esp32_idf:enable_psram=True
esp32_idf:psram_mode=quad
esp32_idf:psram_freq=80mhz

[build_requires]
# ESP32-S3 toolchain
xtensa-esp32s3-elf-gcc/12.2.0

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:jobs=4
tools.compilation:verbosity=verbose
# ESP32-S3 specific configuration
tools.build:defines=ESP32S3=1
tools.build:cxxflags=["-mlongcalls", "-mfix-esp32-psram-cache-issue"]
tools.build:cflags=["-mlongcalls", "-mfix-esp32-psram-cache-issue"]

[profile_conan]
# PlatformIO integration settings for Sunton
platform=espressif32
board=esp32-s3-devkitc-1
framework=espidf
# Sunton display pin configuration
build_flags=
  -DUSER_SETUP_LOADED=1
  -DSunton_ESP32_2432S028=1
  -DTFT_WIDTH=240
  -DTFT_HEIGHT=320
  -DTFT_MISO=19
  -DTFT_MOSI=23
  -DTFT_SCLK=18
  -DTFT_CS=15
  -DTFT_DC=2
  -DTFT_RST=4
  -DTFT_BL=32