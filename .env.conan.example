# SpareTools Conan Docker Environment Variables
# Copy this file to .env and fill in your values

# Cloudsmith API Key for publishing packages
# Get this from: https://cloudsmith.io/user/settings/api-keys/
CLOUDSMITH_API_KEY=your_cloudsmith_api_key_here

# Optional: Conan home directory (defaults to ~/.conan2)
# CONAN_HOME=/workspace/.conan

# Optional: Enable Conan verbose logging
# CONAN_TRACE_FILE=/workspace/conan-trace.log

# Optional: Set Conan to non-interactive mode
# CONAN_NON_INTERACTIVE=true