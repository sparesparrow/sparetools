name: CI - MIA Build and Test

# CI/CD Pipeline for {{project_name}} (MIA Project)
# Validates Python package builds and tests
# Expected duration: 8-15 minutes
# Failure rate target: <5%

on:
  push:
    branches: [ main, develop, 'release/*' ]
  pull_request:
    branches: [ main, develop ]
  workflow_dispatch:

concurrency:
  group: ${{ '{{' }} github.workflow }}-${{ '{{' }} github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

env:
  CONAN_VERSION: "2.21.0"
  VERSION_BASE: "{{base_version}}"
  VERSION_CPYTHON: "{{cpython_version}}"
  VERSION_OPENSSL: "{{openssl_version}}"

jobs:
  # Change detection
  detect-changes:
    runs-on: ubuntu-latest
    outputs:
      code-changed: ${{ '{{' }} steps.changes.outputs.code }}
      skip-tests: ${{ '{{' }} steps.skip.outputs.skip-tests }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: dorny/paths-filter@v3
        id: changes
        with:
          filters: |
            code:
              - 'src/**'
              - 'test/**'
              - 'pyproject.toml'
              - 'conanfile.py'
              - 'requirements*.txt'

      - name: Determine if tests can be skipped
        id: skip
        run: |
          if [[ "${{ '{{' }} steps.changes.outputs.code }}" == "false" ]]; then
            echo "skip-tests=true" >> $GITHUB_OUTPUT
            echo "✅ No code changes, skipping tests"
          else
            echo "skip-tests=false" >> $GITHUB_OUTPUT
            echo "🔨 Code changes detected, running tests"
          fi

  # Code quality checks
  code-quality:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install code quality tools
        run: |
          pip install ruff black mypy pytest-cov

      - name: Check code formatting
        run: |
          echo "🔍 Checking code formatting..."
          black --check src/ test/ || echo "⚠️ Code formatting issues found"

      - name: Lint code
        run: |
          echo "🔍 Running code linting..."
          ruff check src/ test/ || echo "⚠️ Linting issues found"

      - name: Type check
        run: |
          echo "🔍 Running type checking..."
          mypy src/ || echo "⚠️ Type checking issues found"

  # Build and test
  build-test:
    needs: [detect-changes, code-quality]
    if: needs.detect-changes.outputs.skip-tests == 'false'

    strategy:
      fail-fast: false
      matrix:
        python-version: ['3.8', '3.9', '3.10', '3.11', '3.12']
        os: [ubuntu-latest, macos-latest, windows-latest]

    runs-on: ${{ '{{' }} matrix.os }}

    steps:
      - uses: actions/checkout@v4

      - name: Set up Python ${{ '{{' }} matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ '{{' }} matrix.python-version }}

      - name: Install Conan
        run: |
          pip install conan==${{ '{{' }} env.CONAN_VERSION }}
          conan --version

      - name: Configure Conan
        run: |
          conan profile detect --force
          conan remote add sparesparrow-conan \
            https://dl.cloudsmith.io/public/sparesparrow-conan/openssl-conan/conan/ \
            --force || true

      - name: Cache Conan artifacts
        uses: actions/cache@v4
        with:
          path: ~/.conan2
          key: conan-${{ '{{' }} matrix.os }}-py${{ '{{' }} matrix.python-version }}-${{ '{{' }} hashFiles('**/conanfile.py') }}
          restore-keys: |
            conan-${{ '{{' }} matrix.os }}-py${{ '{{' }} matrix.python-version }}
            conan-${{ '{{' }} matrix.os }}-
            conan-

      # Install dependencies
      - name: Install dependencies
        run: |
          conan install . --build=missing

      # Build package
      - name: Build package
        run: |
          conan build .

      # Run tests
      - name: Run tests
        run: |
          conan test test_package

      # Additional Python tests
      - name: Run Python tests with coverage
        run: |
          pip install -e .
          pytest --cov={{module_name}} --cov-report=xml --cov-report=html

      - name: Upload coverage reports
        if: matrix.os == 'ubuntu-latest' && matrix.python-version == '3.12'
        uses: codecov/codecov-action@v3
        with:
          file: ./coverage.xml
          flags: unittests
          name: codecov-umbrella

      - name: Upload test artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-results-${{ '{{' }} matrix.os }}-${{ '{{' }} matrix.python-version }}
          path: |
            htmlcov/
            test-results/
          retention-days: 7

  # Package and publish (on main branch only)
  publish:
    needs: [build-test]
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Build distribution packages
        run: |
          pip install build
          python -m build

      - name: Publish to PyPI (if configured)
        if: env.PYPI_API_TOKEN
        run: |
          pip install twine
          twine upload dist/*
        env:
          TWINE_USERNAME: __token__
          TWINE_PASSWORD: ${{ '{{' }} secrets.PYPI_API_TOKEN }}

  # CI Summary
  ci-summary:
    needs: [detect-changes, code-quality, build-test]
    if: always()
    runs-on: ubuntu-latest
    steps:
      - name: Check CI Results
        run: |
          echo "## 🎯 MIA CI Summary" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY

          if [ "${{ '{{' }} needs.build-test.result }}" == "success" ] || \
             [ "${{ '{{' }} needs.detect-changes.outputs.skip-tests }}" == "true" ]; then
            echo "✅ **CI PASSED**" >> $GITHUB_STEP_SUMMARY
            echo "" >> $GITHUB_STEP_SUMMARY
            echo "All Python builds and tests completed successfully." >> $GITHUB_STEP_SUMMARY
            exit 0
          else
            echo "❌ **CI FAILED**" >> $GITHUB_STEP_SUMMARY
            echo "" >> $GITHUB_STEP_SUMMARY
            echo "Build Status: ${{ '{{' }} needs.build-test.result }}" >> $GITHUB_STEP_SUMMARY
            exit 1
          fi