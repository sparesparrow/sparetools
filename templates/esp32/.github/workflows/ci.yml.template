name: {{project_name}} CI/CD Pipeline

on:
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main, develop ]
  workflow_dispatch:
    inputs:
      run_full_matrix:
        description: 'Run full ESP32 board matrix (slower)'
        required: false
        default: false
        type: boolean
      skip_security:
        description: 'Skip security scanning'
        required: false
        default: false
        type: boolean

env:
  SPARETOOLS_PROJECT_TYPE: embedded/esp32
  SPARETOOLS_PROJECT_NAME: {{project_name}}
  CONAN_USER_HOME: ${{ github.workspace }}/.conan-cache

jobs:
  # Quality checks using reusable workflow
  quality:
    uses: ./.sparetools/.github/workflows/reusable/esp32-quality.yml
    with:
      python-version: '3.12'
      bootstrap-script: 'python scripts/bootstrap.py'
      run-static-analysis: true

  # Unit and integration testing
  test:
    uses: ./.sparetools/.github/workflows/reusable/esp32-testing.yml
    needs: quality
    strategy:
      matrix:
        test-suite: [unit, integration]
    with:
      python-version: '3.12'
      bootstrap-script: 'python scripts/bootstrap.py'
      test-suite: ${{ matrix.test-suite }}
      enable-coverage: true
      run-hardware-simulation: true

  # ESP32 firmware builds
  build-esp32:
    uses: ./.sparetools/.github/workflows/reusable/esp32-build.yml
    needs: quality
    with:
      esp32-boards: ${{ inputs.run_full_matrix && '["esp32dev", "esp32-s3-devkitc-1", "esp32-c3-devkitc-02"]' || '["esp32dev"]' }}
      python-version: '3.12'
      bootstrap-script: 'python scripts/bootstrap.py'
      enable-caching: true

  # Security scanning
  security:
    uses: ./.sparetools/.github/workflows/reusable/esp32-security.yml
    needs: quality
    if: inputs.skip_security != true
    with:
      python-version: '3.12'
      scan-type: 'full'
      generate-sbom: true

  # Integration testing (full suite on main branch)
  integration-full:
    uses: ./.sparetools/.github/workflows/reusable/esp32-testing.yml
    needs: [test, build-esp32]
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    with:
      python-version: '3.12'
      bootstrap-script: 'python scripts/bootstrap.py'
      test-suite: 'all'
      enable-coverage: true
      run-hardware-simulation: true

  # Performance regression testing
  performance:
    runs-on: ubuntu-latest
    needs: [test, build-esp32]
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Set up Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.12'

    - name: Bootstrap development environment
      run: python scripts/bootstrap.py

    - name: Run performance benchmarks
      run: |
        python scripts/test_runner.py --integration-only --report-dir ./perf-results

    - name: Upload performance results
      uses: actions/upload-artifact@v3
      with:
        name: performance-results
        path: perf-results/
        retention-days: 90

  # Deploy to staging (on main branch)
  deploy-staging:
    runs-on: ubuntu-latest
    needs: [integration-full, security]
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    environment: staging
    steps:
    - name: Checkout code
      uses: actions/checkout@v4

    - name: Download firmware artifacts
      uses: actions/download-artifact@v3
      with:
        name: esp32-firmware-esp32dev
        path: ./firmware

    - name: Deploy to staging environment
      run: |
        echo "🚀 Deploying {{project_name}} firmware to staging..."

        # Verify firmware files exist
        ls -la firmware/

        # Placeholder for staging deployment
        # In a real implementation, this would:
        # - Upload firmware to a staging firmware server
        # - Update staging documentation
        # - Trigger integration tests in staging environment
        # - Send notifications to stakeholders

        echo "✅ Staging deployment completed"
        echo "Firmware available at: https://staging.firmware.{{project_name}}.com/"

    - name: Notify stakeholders
      run: |
        # Placeholder for notifications
        # This could send Slack messages, emails, etc.
        echo "📢 Staging deployment notification sent"